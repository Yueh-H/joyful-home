# Copy this template for a new local household; keep existing credentials during migration.
# Never commit a populated .env. GEMINI_API_KEY is optional; manual flows work without it.
GROCY_URL=http://127.0.0.1:9283
GROCY_API_KEY=
HOME_PASSWORD=
SESSION_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Set 0.0.0.0 to allow phones on the same trusted LAN.
HOME_BIND=127.0.0.1

# Local MongoDB is authoritative. Firestore and Grocy remain explicit rollback modes.
INVENTORY_BACKEND=mongodb
MONGODB_URI=mongodb://mongo:27017
MONGODB_DATABASE=joyful_home
HOME_ID=home
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_HOUSEHOLD_ID=home
# Native development only; containers use the private credential volume.
GOOGLE_APPLICATION_CREDENTIALS=
