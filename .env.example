# Run python3 scripts/setup_grocy.py to generate local credentials.
# Never commit a populated .env. GEMINI_API_KEY is optional; manual flows work without it.
GROCY_URL=http://127.0.0.1:9283
GROCY_API_KEY=
HOME_PASSWORD=
SESSION_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Set 0.0.0.0 to allow phones on the same trusted LAN.
HOME_BIND=127.0.0.1
